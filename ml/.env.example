SERVICE_NAME=recommender
BUILD_SHA=dev

# Must point at the SAME MongoDB deployment (and MONGO_DB must be the same
# database name) that the Node server connects to via server/config.env's
# MONGO_URI - the ml service reads the server's own histories/profiles/
# exercises collections directly rather than keeping a parallel copy.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_DB=gymgenius

REST_WINDOW_HOURS=48
REC_TTL_SECONDS=1800

# Nothing in the MVP recommendation loop needs a cache (docs/SPEC.md §1/§4.4).
# Leave this false until there's an actual latency problem to solve - when
# false, the redis package is never even imported.
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=1800

# Packaging / wheels
.eggs/
*.egg-info/
pip-wheel-metadata/
wheels/
build/
dist/
MANIFEST
downloads/

# --- Notebooks (scratch artifacts) ---
*.ipynb~
.ipynb_checkpoints/

# --- Data & ML artifacts ---
# Ignore raw/generated data by default, keep curated seeds
**/data/**
!**/data/.gitkeep
ml/training/datasets/**
!ml/training/datasets/.gitkeep
!ml/training/datasets/manifest.yaml
ml/training/reports/**
!ml/training/reports/.gitkeep

# Model/binary artifacts - trained model output only. ml/artifacts/ is NOT this:
# it holds hand-curated config (equipment/muscle synonym maps, movement-pattern
# tables, etc.) that the training pipeline depends on and must be tracked.
**/*.pkl
**/*.joblib
**/*.pt
**/*.pth
**/*.onnx
**/*.h5
app/models/checkpoints/*
!app/models/checkpoints/.gitkeep

# --- Reports / generated assets ---
reports/
prof/
*.prof
*.lprof
generated/
*.svg
*.png
